# =============================================================================
# IP Customs Vision - Environment Configuration Template
# =============================================================================
#
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env
#
# IMPORTANT: Never commit .env with real API keys to version control
#
# =============================================================================

# -----------------------------------------------------------------------------
# Gemini API Configuration
# -----------------------------------------------------------------------------

# Primary API key (for Gemini LLM provider)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_primary_api_key_here

# Optional: Add multiple API keys for load balancing
# GEMINI_API_KEY_1=your_second_api_key_here
# GEMINI_API_KEY_2=your_third_api_key_here

# -----------------------------------------------------------------------------
# Mistral API Configuration
# -----------------------------------------------------------------------------

# Mistral API key (for Mistral OCR and Chat)
# Get your API key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Mistral OCR model (default: mistral-ocr-latest)
# MISTRAL_OCR_MODEL=mistral-ocr-latest

# Table format in OCR output: "html" or "markdown"
# MISTRAL_TABLE_FORMAT=html

# -----------------------------------------------------------------------------
# Azure OpenAI Configuration
# -----------------------------------------------------------------------------

# Azure OpenAI API key
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# Azure OpenAI endpoint URL
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Azure OpenAI deployment name (GPT-5.5 or your Azure deployment name)
AZURE_OPENAI_DEPLOYMENT=gpt-5.5

# Optional cheaper / mini deployment (falls back to AZURE_OPENAI_DEPLOYMENT)
# AZURE_OPENAI_MINI_DEPLOYMENT=gpt-5.5

# Azure OpenAI API version (use a GPT-5-capable preview)
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# GPT-5.x reasoning effort for extraction: none | low | medium | high
# AZURE_OPENAI_REASONING_EFFORT=low

# Segmentation lab: pairwise VLM (2 page images per call). Uses same key/endpoint as above.
# Deployment must be a vision-capable model. Falls back to AZURE_OPENAI_DEPLOYMENT if unset.
# SEGMENTATION_VLM_DEPLOYMENT=gpt-5.5
# Render DPI for lab VLM (default 200)
# SEGMENTATION_VLM_DPI=200
# Skip VLM if PDF exceeds this page count (default 30)
# SEGMENTATION_VLM_MAX_PAGES=30
# Max concurrent pair API calls (default 5)
# SEGMENTATION_VLM_MAX_CONCURRENT=5

# -----------------------------------------------------------------------------
# HuggingFace Configuration
# -----------------------------------------------------------------------------

# HuggingFace access token (for NuExtract and local models)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# -----------------------------------------------------------------------------
# Chandra OCR Configuration
# -----------------------------------------------------------------------------

# OCR method: 'hf' (HuggingFace local) or 'vllm' (vLLM server)
CHANDRA_OCR_METHOD=hf

# Max output tokens per page
# CHANDRA_MAX_OUTPUT_TOKENS=8192

# -----------------------------------------------------------------------------
# NuExtract / FunctionGemma Configuration
# -----------------------------------------------------------------------------

# FunctionGemma model ID
FUNCTIONGEMMA_MODEL=google/functiongemma-270m-it

# Device: auto, cpu, cuda, mps
# FUNCTIONGEMMA_DEVICE=auto

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------

# Maximum requests per minute per API key
# Gemini Free tier: 15 RPM, Pro tier: 60 RPM
# REQUESTS_PER_MINUTE=15

# -----------------------------------------------------------------------------
# Retry Configuration
# -----------------------------------------------------------------------------

# MAX_RETRIES=3
# RETRY_DELAY=2.0
# TIMEOUT=300

# -----------------------------------------------------------------------------
# Directory Configuration
# -----------------------------------------------------------------------------

# OUTPUT_DIR=output
# TEMP_DIR=temp

# -----------------------------------------------------------------------------
# Validation Configuration
# -----------------------------------------------------------------------------

# ENABLE_VALIDATION=true
# ENABLE_CROSS_VALIDATION=true
# VALIDATION_STRICTNESS=medium
# CONFIDENCE_THRESHOLD=0.7

# -----------------------------------------------------------------------------
# Entra ID / Azure AD Dual-Auth (optional)
# -----------------------------------------------------------------------------
# When enabled, Bearer tokens are validated against Microsoft JWKS first,
# then the existing local HS256 JWT path is tried as fallback.
# AZURE_AD_ENABLED=false
# AZURE_AD_TENANT_ID=your-tenant-id
# AZURE_AD_CLIENT_ID=your-spa-client-id
# AZURE_AD_CLIENT_SECRET=  # optional; not used for JWKS validation

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# LOG_LEVEL=INFO
# LOG_FILE=logs/extraction.log
# LOG_TO_CONSOLE=true
# LOG_TO_FILE=true

# -----------------------------------------------------------------------------
# Processing Configuration
# -----------------------------------------------------------------------------

# CHUNK_SIZE=5
# MIN_PAGES_FOR_CHUNKING=10
# IMAGE_DPI=200

# -----------------------------------------------------------------------------
# Debug Configuration
# -----------------------------------------------------------------------------

# DEBUG_MODE=false
# DRY_RUN=false
# SAVE_RAW_RESPONSES=true

# Log every LLM extraction call (prompt + response) under output/llm-traces/{job_id}/
# and copy llm-trace.jsonl into the job output folder when extraction finishes.
# LLM_TRACE_ENABLED=false
